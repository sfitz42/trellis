{
  "name": "@trellis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/test"
  ],
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "dev": "STATIC_DIR= tsx watch --conditions=development --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@trellis/shared": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "ws": "8.22.0"
  }
}
