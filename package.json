{
  "name": "trellis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trellis/server --filter @trellis/web dev",
    "build": "tsc -b && pnpm --filter @trellis/web build",
    "start": "pnpm --filter @trellis/server start",
    "typecheck": "tsc -b && pnpm --filter @trellis/web typecheck",
    "test": "vitest run",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "jira:auth": "pnpm --filter @trellis/jira exec tsx src/discovery/check-auth.ts",
    "jira:discover": "pnpm --filter @trellis/jira exec tsx src/discovery/explore.ts",
    "jira:help-audit": "pnpm --filter @trellis/jira exec tsx src/discovery/help-audit.ts",
    "jira:fixture": "pnpm --filter @trellis/jira exec tsx src/discovery/make-fixture.ts",
    "trellis": "pnpm --silent --filter @trellis/cli trellis"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "svelte-eslint-parser": "1.9.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
